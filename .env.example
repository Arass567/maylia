# =========================================
# SMART MAIL LA POSTE - Configuration
# =========================================
#
# IMPORTANT: Ne JAMAIS commiter le fichier .env réel !
# Ce fichier .env.example sert de template.
#
# Instructions:
# 1. Copier ce fichier: cp .env.example .env
# 2. Remplir avec vos vraies valeurs
# 3. Le fichier .env est dans .gitignore (ne sera pas commité)
#

# =========================================
# Email Configuration (La Poste)
# =========================================
EMAIL_ADDRESS=votre.email@laposte.net
EMAIL_PASSWORD=votre_mot_de_passe_ici

# =========================================
# IMAP Configuration
# =========================================
IMAP_HOST=imap.laposte.net
IMAP_PORT=993

# =========================================
# SMTP Configuration
# =========================================
SMTP_HOST=smtp.laposte.net
SMTP_PORT=465

# =========================================
# Anthropic Claude API
# =========================================
# Obtenir une clé: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-VOTRE_CLE_API_ICI

# =========================================
# Perplexity API (Web Search)
# =========================================
# Obtenir une clé: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=pplx-VOTRE_CLE_API_ICI

# =========================================
# NOTES DE SÉCURITÉ
# =========================================
# - Ne partagez JAMAIS vos clés API
# - Révoquez immédiatement toute clé exposée
# - Utilisez des clés différentes pour dev/staging/prod
# - Activez la rotation automatique des clés si disponible
